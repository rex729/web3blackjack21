generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  image     String?
  balance         Float    @default(10000)
  experience      Int      @default(0)
  adRewardCount   Int      @default(0)
  lastAdRewardDate DateTime?

  // Daily Missions Tracking
  currentWinStreak     Int       @default(0)
  maxDailyWinStreak    Int       @default(0)
  dailyTotalWins       Int       @default(0)
  dailyMissionsClaimed Json?     // e.g. {"streak3": true, "streak5": false, "total15": false}
  lastMissionDate      DateTime?

  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balance])
  @@index([experience])
}
